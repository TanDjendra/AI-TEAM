# =============================================================================
# AI Team Orchestrator — environment template
# Copy to `.env` (git-ignored). NEVER commit real secrets.
# =============================================================================

# --- 9Router connection (required) ---
# OpenAI-compatible base URL, including the /v1 suffix.
ROUTER_BASE_URL=http://localhost:20128/v1

# Bearer token for 9Router. REQUIRED — there is no fallback.
#
# Why it is mandatory even against localhost: on 9Router, GET /v1/models is
# served WITHOUT authentication, so a missing key passes the model listing and
# only fails later, mid-run, with 401 on /v1/chat/completions.
#
# The 9Router CLI secret on disk is NOT accepted (verified 401) and is
# deliberately never read.
ROUTER_API_KEY=

# Request timeout in milliseconds (optional, default 120000)
ROUTER_TIMEOUT_MS=120000

# Automatic retries for retryable transport/5xx failures (optional, default 2)
ROUTER_MAX_RETRIES=2

# Fail fast at startup with a REAL completion probe (proves the key works).
# Model listing alone is not proof: /v1/models is unauthenticated.
ROUTER_VERIFY_ON_START=false

# --- Models (required) ---
# Verified present in the 9Router catalog via GET /v1/models.
CODER_MODEL=grip/deepseek-v4.1-flash
REVIEWER_MODEL=grip/gpt-5.6-luna

# --- Orchestrator limits (optional) ---
# 1 review pass = one Reviewer call. After each REJECTED review the cycle
# counter increments, so this also bounds the number of fix rounds.
# MAX_REVIEW_CYCLES=3
# MAX_AGENT_ATTEMPTS=2

# --- Logging (optional) ---
# debug | info | warn | error (default: info)
LOG_LEVEL=info
# text | json (default: text)
LOG_FORMAT=text

# --- Workspace sandbox (optional) ---
# Root the Coder is allowed to modify. Default: <project>/workspace
ORCH_WORKSPACE_ROOT=

# --- Database / persistence (optional) ---
# PostgreSQL connection string. Supabase Postgres works as-is:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# LEAVE EMPTY to run without persistence: the orchestrator still works and
# events are published to the in-process bus, but nothing is stored. With a
# database configured, the nine tables in supabase/migrations are created
# automatically at startup and every run is recorded.
DATABASE_URL=

# Require TLS (set true for most hosted Postgres, including Supabase).
DATABASE_SSL=false

# Connection pool size (optional, default 10)
DATABASE_MAX_CONNECTIONS=10

# Directory holding the *.sql migrations (optional, default supabase/migrations)
# DATABASE_MIGRATIONS_DIR=

# Refuse to mark a task DONE when persistence is unhealthy (optional, default true).
# Set false only if losing the record of a completed task is acceptable.
DATABASE_REQUIRE_PERSISTENCE=true

# --- Test hooks (leave unset in normal use) ---
# RUN_LIVE=1 enables tests/live/* against the real router.
RUN_LIVE=
